########################################
# Unified VAST repo ignores
########################################

# Test / run output directories (tests/ is tracked; see tests/conftest.py)
outputs/
inputmap/
logs/
#scratch/
my_todo*.txt
teach/

# Python bytecode / extensions
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/

# Tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# uv / Python version managers
.python-version

# Logs
*.log
sleap_nn_inference.log

# Jupyter
.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
*~
*\[Autosaved\]*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Data / large artifacts (tune as needed)
*.h5
*.mp4

# Per-machine path overrides (copy paths_local.example.py → paths_local.py)
maze/pipeline/paths_local.py
maze/pipeline/config_local.py

# local config