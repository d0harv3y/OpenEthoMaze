[Unit]
Description=bhvr-kiosk Chromium fullscreen
After=bhvr-kiosk-web.service graphical-session.target
Requires=bhvr-kiosk-web.service

[Service]
Type=simple
User=admin
Environment=DISPLAY=:0
ExecStartPre=/bin/sleep 2
ExecStart=/usr/bin/chromium --kiosk --noerrdialogs --disable-session-crashed-bubble --check-for-update-interval=31536000 http://127.0.0.1:8080
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
