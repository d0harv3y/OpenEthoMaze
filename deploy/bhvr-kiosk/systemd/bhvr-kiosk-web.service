[Unit]
Description=bhvr-kiosk web (session console)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/bhvr-kiosk
Environment=PATH=/home/admin/bhvr-kiosk/.venv/bin:/usr/bin
ExecStart=/home/admin/bhvr-kiosk/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8080
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
